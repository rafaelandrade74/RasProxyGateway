{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build TunnelServer",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "TunnelServer/TunnelServer.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build TunnelClient",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "TunnelClient/TunnelClient.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
